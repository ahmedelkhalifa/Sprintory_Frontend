# Backend API address
VITE_API_URL=http://localhost:8080/api/v1

# TEMP: set to true to skip login while the backend isn't ready.
# Never set this in production.
VITE_SKIP_AUTH=

# Optional, build-time flag for the Jira one-time import panel (requires server-side enablement).
# For production builds use VITE_ENABLE_JIRA_IMPORT=true only during an approved migration.
VITE_ENABLE_JIRA_IMPORT=false
