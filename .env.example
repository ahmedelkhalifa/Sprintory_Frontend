# Backend API address
VITE_API_URL=http://localhost:8080/api/v1

# TEMP: set to true to skip login while the backend isn't ready.
# Never set this in production.
VITE_SKIP_AUTH=

# TEMP: the backend has no sprints yet (dev-docs/tasks.md), so the Backlog and Board tabs keep them in an
# in-browser mock (tasks are real). On unless this is false. Remove once the endpoints exist.
VITE_MOCK_SPRINTS=

# TEMP: the backend has no audit log yet (PMP-128, dev-docs/audit-log.md), so the Audit Log page runs on an
# in-browser mock with made-up entries. On unless this is false. Remove once the endpoints exist.
VITE_MOCK_AUDIT=
